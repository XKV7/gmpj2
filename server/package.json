{
  "name": "@moyeo/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "cross-env NODE_ENV=production tsx src/index.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "http-proxy": "^1.18.1",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/http-proxy": "^1.17.17",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
